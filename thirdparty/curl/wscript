CURL_SOURCES_ANDROID = CURL_SOURCES_LINUX

def configure(conf):
    src_dir = conf.path.abspath()
    config_map = {
        'win32':   'curl_config_win32.h',
        'darwin':  'curl_config_darwin.h',
        'android': 'curl_config_android.h',
    }
    src_file = config_map.get(conf.env.DEST_OS, 'curl_config_linux.h')
    
    shutil.copy(
        os.path.join(src_dir, 'lib', src_file),
        os.path.join(src_dir, 'lib', 'curl_config.h')
    )

def build(bld):
    curl_dir = bld.path.abspath()

    sources = list(CURL_SOURCES)

    defines = [
        'BUILDING_LIBCURL',
        'CURL_STATICLIB',
        'CURL_DISABLE_LDAP',
        'CURL_DISABLE_LDAPS',
        'CURL_DISABLE_RTMP',
        'CURL_DISABLE_DICT',
        'USE_THREADS_POSIX',
        'HAVE_CONFIG_H',
    ]

    if bld.env.DEST_OS == 'win32':
        sources += CURL_SOURCES_WIN32
        defines += [
            'USE_SCHANNEL',
            'USE_WINDOWS_SSPI',
            'USE_WIN32_CRYPTO',
            'USE_THREADS_WIN32',
        ]
        defines.remove('USE_THREADS_POSIX')
    elif bld.env.DEST_OS == 'darwin':
        sources += CURL_SOURCES_DARWIN
        defines += ['USE_SECTRANSP']
    elif bld.env.DEST_OS == 'android':
        sources += CURL_SOURCES_ANDROID
        defines += ['USE_OPENSSL']
    else:
        sources += CURL_SOURCES_LINUX
        defines += ['USE_OPENSSL']

    bld.stlib(
        source          = sources,
        target          = 'curl',
        includes        = [
            os.path.join(curl_dir, 'include'),
            os.path.join(curl_dir, 'lib'),
        ],
        defines         = defines,
        export_includes = [os.path.join(curl_dir, 'include')],
        export_defines  = ['CURL_STATICLIB'],
        uselib_store    = 'CURL',
        use             = 'ZLIB',
    )
